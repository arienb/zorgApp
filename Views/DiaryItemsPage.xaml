<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             xmlns:models="clr-namespace:zorgApp.Models"
             xmlns:converters="clr-namespace:zorgApp.Converters"
             x:Class="zorgApp.Views.DiaryItemsPage"
             x:DataType="viewmodels:DiaryPageViewModel"
             Title="{Binding PatientName, StringFormat='Dagboek {0}'}"
             BackgroundColor="#F5F7FA">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            IconImageSource="profile.png"
            Text="Profiel"
            Command="{Binding NavigateToProfileCommand}"
            CommandParameter="{Binding SelectedItem}"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
        <!-- Diary Items List -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDiaryItemsCommand}"
                     RefreshColor="#6366F1">

            <VerticalStackLayout Spacing="12">
                <Button Text="+ Notificatie toevoegen"
                    Command="{Binding AddOrReplaceNotificationCommand}"
                    IsVisible="{Binding IsNurseMode}"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="44"/>

                <Border BackgroundColor="#FEF3C7"
                        StrokeThickness="0"
                        Padding="12"
                        Margin="16,0,16,10"
                        IsVisible="{Binding Notification, Converter={StaticResource NullToBoolConverter}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="⚠️"
                               FontSize="18"
                               VerticalOptions="Center"/>
                        <Label Text="{Binding Notification.Message}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#92400E"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <CollectionView ItemsSource="{Binding DiaryItems}"
                            SelectionMode="None"
                            Margin="0,10,0,0">
                <CollectionView.EmptyView>
                    <StackLayout Padding="40"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                Padding="40,50">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,4"
                                        Radius="12"
                                        Opacity="0.1" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="15">
                                <Label Text="📝"
                                       FontSize="80"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,0,0,10" />
                                <Label Text="Nog geen dagboek items"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Druk op de + knop om een item toe te voegen"
                                       FontSize="15"
                                       TextColor="#6B7280"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </Border>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiaryItem">
                        <Border Margin="16,8"
                                Padding="0"
                                StrokeThickness="0"
                                BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#6366F1"
                                        Offset="0,4"
                                        Radius="12"
                                        Opacity="0.15" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryPageViewModel}}, Path=ItemTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,*" Padding="0">
                                <!-- Colored Header Bar -->
                                <Border Grid.Row="0"
                                        StrokeThickness="0"
                                        HeightRequest="6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20,20,0,0" />
                                    </Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6366F1" Offset="0.0" />
                                            <GradientStop Color="#8B5CF6" Offset="0.5" />
                                            <GradientStop Color="#EC4899" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Content -->
                                <VerticalStackLayout Grid.Row="1" 
                                                     Spacing="12" 
                                                     Padding="20,16,20,20">

                                    <!-- TITEL -->
                                    <Label Text="{Binding Title}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937"
                                           LineBreakMode="WordWrap"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Fill" />

                                    <!-- Info Section -->
                                    <Grid ColumnDefinitions="*,*" 
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="10"
                                          ColumnSpacing="10"
                                          Margin="0,4,0,0">

                                        <!-- DATUM -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Padding="12,8"
                                                StrokeThickness="0"
                                                BackgroundColor="#FEF3C7">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="📅"
                                                       FontSize="16"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Timestamp, StringFormat='{0:dd/MM/yyyy}'}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#92400E"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- TIJD -->
                                        <Border Grid.Row="0" Grid.Column="1"
                                                Padding="12,8"
                                                StrokeThickness="0"
                                                BackgroundColor="#DBEAFE">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="🕐"
                                                       FontSize="16"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#1E40AF"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>

                                        <!-- MAKER -->
                                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                Padding="12,8"
                                                StrokeThickness="0"
                                                BackgroundColor="#E0E7FF">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="👤"
                                                       FontSize="16"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding CreatedBy}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="#4338CA"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            </VerticalStackLayout>
        </RefreshView>

        <!-- Moderne Add Button met Gradient -->
        <Border Grid.Row="1"
                WidthRequest="70"
                HeightRequest="70"
                StrokeThickness="0"
                Margin="0,0,20,20"
                HorizontalOptions="End"
                VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="35" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0.0" />
                    <GradientStop Color="#8B5CF6" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#6366F1"
                        Offset="0,6"
                        Radius="20"
                        Opacity="0.4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddItemCommand}" />
            </Border.GestureRecognizers>

            <Label Text="+"
                   FontSize="40"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>