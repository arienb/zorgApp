<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             xmlns:converters="clr-namespace:zorgApp.Converters"
             x:Class="zorgApp.Views.AddDiaryItemPage"
             x:DataType="viewmodels:AddDiaryItemViewModel"
             Title="{Binding IsEditMode, Converter={StaticResource DiaryItemEditModeTitleConverter}}"
             BackgroundColor="#F5F7FA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:NullToInverseBoolConverter x:Key="NullToInverseBoolConverter" />
            <converters:DiaryItemEditModeTitleConverter x:Key="DiaryItemEditModeTitleConverter" />
            <converters:DiaryItemEditModeButtonConverter x:Key="DiaryItemEditModeButtonConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Diary Item Card -->
            <Border StrokeThickness="0" 
                    Padding="0" 
                    BackgroundColor="White"
                    Margin="0,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#9ED5CB" Offset="0,4" Radius="12" Opacity="0.15"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*" Padding="0">
                    <!-- Colored Header Bar - Jessa Groen -->
                    <Border Grid.Row="0"
                            BackgroundColor="#9ED5CB"
                            StrokeThickness="0"
                            HeightRequest="6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20,20,0,0" />
                        </Border.StrokeShape>
                    </Border>

                    <!-- Content -->
                    <VerticalStackLayout Grid.Row="1" 
                                         Spacing="16" 
                                         Padding="20,20,20,24">

                        <!-- Header met emoji -->
                        <HorizontalStackLayout Spacing="12" Margin="0,0,0,8">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E0F2EF" Offset="0.0" />
                                        <GradientStop Color="#D1FAE5" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="📝"
                                       FontSize="28"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Dagboek Item"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="2"
                                 CornerRadius="1"
                                 Margin="0,0,0,8">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0.0" />
                                    <GradientStop Color="#E5E7EB" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <!-- Title -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Titel *"
                                   FontSize="13"
                                   TextColor="#6B7280"
                                   FontAttributes="Bold"/>
                            <Border Padding="14,12"
                                    StrokeThickness="0"
                                    BackgroundColor="#F9FAFB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding Title}"
                                       Placeholder="Bijv. Eerste wandeling"
                                       MaxLength="100"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Beschrijving *"
                                   FontSize="13"
                                   TextColor="#6B7280"
                                   FontAttributes="Bold"/>
                            <Border Padding="14,12"
                                    StrokeThickness="0"
                                    BackgroundColor="#F9FAFB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Editor Text="{Binding Description}"
                                        Placeholder="Beschrijf wat er gebeurd is..."
                                        HeightRequest="150"
                                        AutoSize="TextChanges"
                                        BackgroundColor="Transparent"
                                        TextColor="#1F2937"
                                        PlaceholderColor="#9CA3AF"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Image -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Foto (optioneel)"
                                   FontSize="13"
                                   TextColor="#6B7280"
                                   FontAttributes="Bold"/>

                            <!-- Image Preview met Jessa groene bar -->
                            <Border StrokeThickness="0"
                                    BackgroundColor="#F9FAFB"
                                    Padding="0"
                                    IsVisible="{Binding Image, Converter={StaticResource NullToBoolConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Colored Header Bar -->
                                    <Border Grid.Row="0"
                                            BackgroundColor="#9ED5CB"
                                            StrokeThickness="0"
                                            HeightRequest="4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12,12,0,0" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Image Grid.Row="1"
                                           Source="{Binding Image}"
                                           Aspect="AspectFit"
                                           HeightRequest="200"
                                           Margin="8"/>
                                </Grid>
                            </Border>

                            <!-- Placeholder -->
                            <Border StrokeThickness="2"
                                    Stroke="#E5E7EB"
                                    HeightRequest="200"
                                    BackgroundColor="#F9FAFB"
                                    IsVisible="{Binding Image, Converter={StaticResource NullToInverseBoolConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout VerticalOptions="Center" 
                                                     HorizontalOptions="Center"
                                                     Spacing="12">
                                    <Label Text="📷"
                                           FontSize="48"
                                           HorizontalOptions="Center"/>
                                    <Label Text="Nog geen foto geselecteerd"
                                           TextColor="#6B7280"
                                           FontSize="14"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Image Button -->
                            <Border StrokeThickness="0"
                                    HeightRequest="44"
                                    Margin="0,4,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E0F2EF" Offset="0.0" />
                                        <GradientStop Color="#D1FAE5" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PickImageCommand}" />
                                </Border.GestureRecognizers>
                                <Label FontSize="14" 
                                       FontAttributes="Bold"
                                       TextColor="#065F46"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                    Binding="{Binding Image, Converter={StaticResource NullToBoolConverter}}"
                                                    Value="True">
                                            <Setter Property="Text" Value="📷 Foto wijzigen" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label"
                                                    Binding="{Binding Image, Converter={StaticResource NullToBoolConverter}}"
                                                    Value="False">
                                            <Setter Property="Text" Value="📷 Foto kiezen" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Date & Time Grid -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <!-- Date -->
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="Datum"
                                       FontSize="13"
                                       TextColor="#6B7280"
                                       FontAttributes="Bold"/>
                                <Border Padding="14,8"
                                        StrokeThickness="0"
                                        BackgroundColor="#F9FAFB">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <DatePicker Date="{Binding Timestamp}" 
                                                Format="dd/MM/yyyy"
                                                BackgroundColor="Transparent"
                                                TextColor="#1F2937"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Time -->
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="Tijd"
                                       FontSize="13"
                                       TextColor="#6B7280"
                                       FontAttributes="Bold"/>
                                <Border Padding="14,8"
                                        StrokeThickness="0"
                                        BackgroundColor="#F9FAFB">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <TimePicker Time="{Binding Time}" 
                                                Format="HH:mm"
                                                BackgroundColor="Transparent"
                                                TextColor="#1F2937"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Created By -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Toegevoegd door"
                                   FontSize="13"
                                   TextColor="#6B7280"
                                   FontAttributes="Bold"/>
                            <Border Padding="14,12"
                                    StrokeThickness="0"
                                    BackgroundColor="#F9FAFB">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Entry Text="{Binding CreatedBy}"
                                       Placeholder="Bijv. Verpleging - Sarah"
                                       BackgroundColor="Transparent"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                                           IsVisible="{Binding IsSaving}"
                                           Color="#9ED5CB"
                                           Margin="0,10,0,0"/>

                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,*" 
                              ColumnSpacing="12"
                              Margin="0,16,0,0">
                            
                            <!-- Annuleren Button -->
                            <Border Grid.Column="0"
                                    StrokeThickness="0"
                                    HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E5E7EB" Offset="0.0" />
                                        <GradientStop Color="#D1D5DB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CancelCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Annuleren"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#4B5563"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True"/>
                            </Border>

                            <!-- Save Button -->
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#9ED5CB" Offset="0.0" />
                                        <GradientStop Color="#7AB8B3" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Shadow>
                                    <Shadow Brush="#9ED5CB"
                                            Offset="0,4"
                                            Radius="12"
                                            Opacity="0.3" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SaveCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding IsEditMode, Converter={StaticResource DiaryItemEditModeButtonConverter}}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       InputTransparent="True"/>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>