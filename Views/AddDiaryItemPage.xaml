<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             xmlns:converters="clr-namespace:zorgApp.Converters"
             x:Class="zorgApp.Views.AddDiaryItemPage"
             x:DataType="viewmodels:AddDiaryItemViewModel"
             Title="{Binding IsEditMode, Converter={StaticResource DiaryItemEditModeTitleConverter}}"
             BackgroundColor="#F5F7FA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:NullToInverseBoolConverter x:Key="NullToInverseBoolConverter" />
            <converters:DiaryItemEditModeTitleConverter x:Key="DiaryItemEditModeTitleConverter" />
            <converters:DiaryItemEditModeButtonConverter x:Key="DiaryItemEditModeButtonConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Diary Item Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <!-- Title -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Titel *"
                               FontSize="13"
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding Title}"
                               Placeholder="Bijv. Eerste wandeling"
                               MaxLength="100"
                               BackgroundColor="#F9FAFB"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"/>
                    </VerticalStackLayout>

                    <!-- Description -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Beschrijving *"
                               FontSize="13"
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Editor Text="{Binding Description}"
                                Placeholder="Beschrijf wat er gebeurd is..."
                                HeightRequest="150"
                                AutoSize="TextChanges"
                                BackgroundColor="#F9FAFB"
                                TextColor="#1F2937"
                                PlaceholderColor="#9CA3AF"/>
                    </VerticalStackLayout>

                    <!-- Image -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Foto (optioneel)"
                               FontSize="13"
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>

                        <Grid>
                            <!-- Show selected Image -->
                            <Image Source="{Binding Image}"
                                   Aspect="AspectFit"
                                   IsVisible="{Binding Image, Converter={StaticResource NullToBoolConverter}}"/>

                            <!-- Placeholder -->
                            <Border HeightRequest="200"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding Image, Converter={StaticResource NullToInverseBoolConverter}}">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="Nog geen foto geselecteerd"
                                           TextColor="Gray"
                                           FontSize="14"
                                           HorizontalOptions="Center"/>
                                    <Button Text="Foto kiezen"
                                            Command="{Binding PickImageCommand}"
                                            Margin="0,10,0,0"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            Padding="10,5"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Change Image Button -->
                        <Button Text="Foto wijzigen"
                                Command="{Binding PickImageCommand}"
                                IsVisible="{Binding Image, Converter={StaticResource NullToBoolConverter}}"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                Margin="0,5,0,0"/>
                    </VerticalStackLayout>

                    <!-- Date -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Datum"
                               FontSize="13"
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <DatePicker Date="{Binding Timestamp}" Format="dd/MM/yyyy"/>
                    </VerticalStackLayout>

                    <!-- Time -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tijd"
                               FontSize="13"
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <TimePicker Time="{Binding Time}" Format="HH:mm"/>
                    </VerticalStackLayout>

                    <!-- Created By -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Toegevoegd door"
                               FontSize="13"
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding CreatedBy}"
                               Placeholder="Bijv. Verpleging - Sarah"
                               BackgroundColor="#F9FAFB"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"/>
                    </VerticalStackLayout>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                        <Button Grid.Column="0"
                                Text="Annuleren"
                                BackgroundColor="Gray"
                                TextColor="White"
                                FontAttributes="Bold"
                                Command="{Binding CancelCommand}"/>

                        <Button Grid.Column="1"
                                Text="{Binding IsEditMode, Converter={StaticResource DiaryItemEditModeButtonConverter}}"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                FontAttributes="Bold"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsSaving}"
                                       IsVisible="{Binding IsSaving}"
                                       Color="#2563EB"
                                       Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>