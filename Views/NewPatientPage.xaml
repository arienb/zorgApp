<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:zorgApp.ViewModels"
             x:Class="zorgApp.Views.NewPatientPage"
             x:DataType="viewModels:NewPatientViewModel"
             Title="{Binding IsEditMode, Converter={StaticResource EditModeTitleConverter}}"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Patient Form Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">

                    <!-- Naam -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Naam*" 
                               FontSize="13" 
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding Name}"
                               Placeholder="Voer naam in"
                               BackgroundColor="#F9FAFB"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email*" 
                               FontSize="13" 
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding Email}"
                               Placeholder="Voer email in"
                               Keyboard="Email"
                               BackgroundColor="#F9FAFB"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>

                    <!-- Leeftijd -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Leeftijd*" 
                               FontSize="13" 
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding AgeText}"
                               Placeholder="Voer leeftijd in"
                               Keyboard="Numeric"
                               BackgroundColor="#F9FAFB"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>

                    <!-- Kamernummer -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Kamernummer*" 
                               FontSize="13" 
                               TextColor="#6B7280"
                               FontAttributes="Bold"/>
                        <Entry Text="{Binding RoomNumber}"
                               Placeholder="Voer kamernummer in"
                               BackgroundColor="#F9FAFB"
                               TextColor="#1F2937"
                               PlaceholderColor="#9CA3AF"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                    </VerticalStackLayout>

                    <!-- Info -->
                    <Label Text="* Alle velden zijn verplicht"
                           FontSize="12"
                           TextColor="#6B7280"
                           Margin="0,0,0,10"/>

                    <!-- Loading indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       Margin="0,20,0,0"/>

                    <!-- Buttons -->
                    <Button Text="Opslaan"
                            Command="{Binding SavePatientCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="48"
                            CornerRadius="10"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                    <Button Text="Annuleren"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="Gray"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="48"
                            CornerRadius="10"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>