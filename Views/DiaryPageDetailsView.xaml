<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             x:Class="zorgApp.Views.DiaryPageDetailsView"
             x:DataType="viewmodels:DiaryPageDetailsViewModel"
             Title="{Binding DiaryItem.Title}"
             BackgroundColor="#F5F7FA"
             Shell.NavBarIsVisible="True">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding GoBackCommand}" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*,Auto">
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="#6366F1"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />

        <!-- Content -->
        <ScrollView Grid.Row="0"
                    IsVisible="{Binding DiaryItem, Converter={StaticResource IsNotNullConverter}}">
            <VerticalStackLayout Padding="20" Spacing="20">               

                <!-- Info Cards -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="15" ColumnSpacing="15">

                    <!-- Datum Card -->
                    <Border Grid.Row="0" Grid.Column="0" Padding="20,16" StrokeThickness="0" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#DBEAFE" Offset="0,4" Radius="12" Opacity="0.5" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="📅" FontSize="32" HorizontalTextAlignment="Center" />
                            <Label Text="Datum" FontSize="12" TextColor="#6B7280" HorizontalTextAlignment="Center" FontAttributes="Bold" />
                            <Label Text="{Binding DiaryItem.Timestamp, StringFormat='{0:dd/MM/yyyy}'}"
                                   FontSize="13"
                                   TextColor="#1F2937"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tijd Card -->
                    <Border Grid.Row="0" Grid.Column="1" Padding="20,16" StrokeThickness="0" BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#DBEAFE" Offset="0,4" Radius="12" Opacity="0.5" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🕐" 
                                   FontSize="32"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Tijd"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding DiaryItem.Timestamp, StringFormat='{0:HH:mm}'}"
                                   FontSize="16"
                                   TextColor="#1F2937"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Maker Card -->
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Padding="20,16"
                            StrokeThickness="0"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E0E7FF"
                                    Offset="0,4"
                                    Radius="12"
                                    Opacity="0.5" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="👤"
                                   FontSize="32"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Gemaakt door"
                                   FontSize="12"
                                   TextColor="#6B7280"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding DiaryItem.CreatedBy}"
                                   FontSize="16"
                                   TextColor="#1F2937"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Beschrijving Card -->
                <Border Padding="24"
                        StrokeThickness="0"
                        BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="0,4"
                                Radius="12"
                                Opacity="0.1" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <!-- Header -->
                        <HorizontalStackLayout Spacing="10">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#EEF2FF" Offset="0.0" />
                                        <GradientStop Color="#E0E7FF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="📝"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Beschrijving"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Divider -->
                        <BoxView HeightRequest="2"
                                 CornerRadius="1">
                            <BoxView.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0.0" />
                                    <GradientStop Color="#E5E7EB" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1.0" />
                                </LinearGradientBrush>
                            </BoxView.Background>
                        </BoxView>

                        <!-- Description Text -->
                        <Label Text="{Binding DiaryItem.Description}"
                               FontSize="16"
                               TextColor="#374151"
                               LineHeight="1.6"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Action Buttons -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="15"
              Padding="20"
              BackgroundColor="#F5F7FA">

            <!-- Edit Button -->
            <Border Grid.Column="0"
                    StrokeThickness="0"
                    HeightRequest="55">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0.0" />
                        <GradientStop Color="#8B5CF6" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#6366F1"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.3" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditItemCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="8"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center">
                    <Label Text="✏️"
                           FontSize="20"
                           VerticalOptions="Center" />
                    <Label Text="Bewerken"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Delete Button -->
            <Border Grid.Column="1"
                    StrokeThickness="0"
                    HeightRequest="55">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EF4444" Offset="0.0" />
                        <GradientStop Color="#DC2626" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#EF4444"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.3" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeleteItemCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="8"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center">
                    <Label Text="🗑️"
                           FontSize="20"
                           VerticalOptions="Center" />
                    <Label Text="Verwijderen"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>