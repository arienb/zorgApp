<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             x:Class="zorgApp.Views.AddDiaryItemView"
             xmlns:converters="clr-namespace:zorgApp.Converters"
             x:DataType="viewmodels:AddDiaryItemViewModel"
             Title="Nieuw Dagboek Item">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <converters:NullToInverseBoolConverter x:Key="NullToInverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label Text="Titel *"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Entry Text="{Binding Title}"
                   Placeholder="Bijv. Eerste wandeling"
                   MaxLength="100" />

            <!-- Description -->
            <Label Text="Beschrijving *"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Editor Text="{Binding Description}"
                    Placeholder="Beschrijf wat er gebeurd is..."
                    HeightRequest="150"
                    AutoSize="TextChanges" />

            <!-- Image -->
            <Label Text="Foto (optioneel)"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Grid>
                <!-- show selected Image -->
                <Image Source="{Binding Image}" 
                        Aspect="AspectFit"
                        IsVisible="{Binding Image, Converter={StaticResource NullToBoolConverter}}" />

                <!-- Placeholder for Image -->
                <Border HeightRequest="200"
                        VerticalOptions="Center"
                        HorizontalOptions="Fill"
                        IsVisible="{Binding Image, Converter={StaticResource NullToInverseBoolConverter}}">
                    <StackLayout IsVisible="{Binding Image, Converter={StaticResource NullToInverseBoolConverter}}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                        <Label Text="Nog geen foto geselecteerd"
                               TextColor="Gray"
                               FontSize="14"
                               HorizontalOptions="Center" />
                        <Button Text="Foto kiezen"
                                Command="{Binding PickImageCommand}"
                                Margin="0,10,0,0"
                                BackgroundColor="#3498DB"
                                TextColor="White"
                                Padding="10,5" />
                    </StackLayout>
                </Border>
            </Grid>

            <!-- Date -->
            <Label Text="Datum"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <DatePicker Date="{Binding Timestamp}"
                        Format="dd/MM/yyyy" />

            <!-- Time -->
            <Label Text="Tijd"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <TimePicker Time="{Binding Time}"
                        Format="HH:mm" />

            <!-- Created By -->
            <Label Text="Toegevoegd door"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Entry Text="{Binding CreatedBy}"
                   Placeholder="Bijv. Verpleging - Sarah" />

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,20,0,0">

                <Button Grid.Column="0"
                        Text="Annuleren"
                        BackgroundColor="LightGray"
                        TextColor="Black"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Text="Opslaan"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        Command="{Binding SaveCommand}" />
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                              IsVisible="{Binding IsSaving}"
                              Color="#3498DB"
                              Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>