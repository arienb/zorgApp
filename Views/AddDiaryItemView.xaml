<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             x:Class="zorgApp.Views.AddDiaryItemView"
             x:DataType="viewmodels:AddDiaryItemViewModel"
             Title="Nieuw Dagboek Item">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Title -->
            <Label Text="Titel *"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Entry Text="{Binding Title}"
                   Placeholder="Bijv. Eerste wandeling"
                   MaxLength="100" />

            <!-- Description -->
            <Label Text="Beschrijving *"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Editor Text="{Binding Description}"
                    Placeholder="Beschrijf wat er gebeurd is..."
                    HeightRequest="150"
                    AutoSize="TextChanges" />

            <!-- Date -->
            <Label Text="Datum"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <DatePicker Date="{Binding Timestamp}"
                        Format="dd/MM/yyyy" />

            <!-- Time -->
            <Label Text="Tijd"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <TimePicker Time="{Binding Time}"
                        Format="HH:mm" />

            <!-- Created By -->
            <Label Text="Toegevoegd door"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Entry Text="{Binding CreatedBy}"
                   Placeholder="Bijv. Verpleging - Sarah" />

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,20,0,0">

                <Button Grid.Column="0"
                        Text="Annuleren"
                        BackgroundColor="LightGray"
                        TextColor="Black"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="1"
                        Text="Opslaan"
                        BackgroundColor="#3498DB"
                        TextColor="White"
                        Command="{Binding SaveCommand}" />
            </Grid>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                              IsVisible="{Binding IsSaving}"
                              Color="#3498DB"
                              Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>