<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             x:Class="zorgApp.Views.StartupSelectionPage"
             x:DataType="viewmodels:StartupSelectionViewModel"
             BackgroundColor="#F5F7FA"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto" Padding="30,60,30,30">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="30"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <Label Text="🩺"
                   FontSize="90"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Label Text="Welkom!"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#1F2937" />

            <Label Text="Mijn digitale dagboek"
                   FontSize="16"
                   TextColor="#6B7280"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,30" />

            <Border
                StrokeThickness="0"
                HeightRequest="80"
                HorizontalOptions="Fill"
                MaximumWidthRequest="400">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6366F1" Offset="0.0" />
                        <GradientStop Color="#8B5CF6" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#6366F1"
                            Offset="0,8"
                            Radius="20"
                            Opacity="0.3" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PatientCommand}" />
                </Border.GestureRecognizers>

                <VerticalStackLayout 
                    Spacing="6"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                    <Label Text="Inloggen als Patiënt"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16,12"
                StrokeThickness="1"
                Stroke="#D1D5DB"
                BackgroundColor="White"
                HorizontalOptions="Fill"
                MaximumWidthRequest="400"
                Margin="0,20,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NurseCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout 
                    Spacing="10"
                    HorizontalOptions="Center">
                    <Label Text="🩹"
                           FontSize="18"
                           VerticalOptions="Center" />
                    <Label Text="Verpleegkundige login"
                           FontSize="15"
                           TextColor="#6B7280"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Label Grid.Row="1"
               Text="zorgApp © 2025"
               FontSize="12"
               TextColor="#9CA3AF"
               HorizontalTextAlignment="Center"
               Margin="0,20,0,0" />
    </Grid>
</ContentPage>