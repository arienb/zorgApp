<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             x:Class="zorgApp.Views.StartupSelectionPage"
             x:DataType="viewmodels:StartupSelectionViewModel"
             BackgroundColor="#9ED5CB"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="50,70,50,50">

        <!-- Logo en Welkom -->
        <VerticalStackLayout
            Grid.Row="0"
            Spacing="40"
            VerticalOptions="Center"
            HorizontalOptions="Center">

            <!-- Logo -->
            <Image Source="logo_jessa_iccu.png"
                   HeightRequest="100"
                   WidthRequest="290"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <!-- Welkom Text -->
            <Label Text="Welkom bij uw digitaal dagboek!"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="White"
                   Margin="0,20,0,0" />
        </VerticalStackLayout>

        <!-- Login Buttons -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="20"
            HorizontalOptions="Center">

            <!-- Patient Login Button -->
            <Border
                StrokeThickness="0"
                HeightRequest="70"
                WidthRequest="350"
                BackgroundColor="White"
                HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="35" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PatientCommand}" />
                </Border.GestureRecognizers>

                <Label Text="Inloggen als Patiënt"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#7BC1B5"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- Nurse Login Button -->
            <Border
                StrokeThickness="3"
                Stroke="White"
                HeightRequest="70"
                WidthRequest="250"
                BackgroundColor="Transparent"
                HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="35" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NurseCommand}" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout 
                    Spacing="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label Text="Verpleegkundige login"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- Info Button -->
        <Border
            Grid.Row="2"
            WidthRequest="50"
            HeightRequest="50"
            StrokeThickness="2"
            Stroke="White"
            BackgroundColor="Transparent"
            HorizontalOptions="Center"
            Margin="0,30,0,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="25" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShowInfoCommand}" />
            </Border.GestureRecognizers>

            <Label Text="i"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Border>

        <!-- Copyright -->
        <Label Grid.Row="3"
               Text="Jessa Ziekenhuis © 2025"
               FontSize="13"
               TextColor="White"
               Opacity="0.8"
               HorizontalTextAlignment="Center" />

        <!-- Info Popup -->
        <Grid Grid.RowSpan="4"
              IsVisible="{Binding IsInfoPopupVisible}"
              BackgroundColor="#CC000000"
              Padding="0"
              Margin="-50,-70,-50,-50">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseInfoCommand}" />
            </Grid.GestureRecognizers>

            <Border
                BackgroundColor="White"
                StrokeThickness="0"
                WidthRequest="460"
                MaximumHeightRequest="780"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                Margin="20"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Border Grid.Row="0"
                            BackgroundColor="#9ED5CB"
                            StrokeThickness="0"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24,24,0,0" />
                        </Border.StrokeShape>
                        
                        <VerticalStackLayout Padding="24,20" Spacing="10">
                            <Image Source="logo_jessa.png"
                                   HeightRequest="50"
                                   WidthRequest="180"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Content -->
                    <ScrollView Grid.Row="1" Padding="32,28">
                        <VerticalStackLayout Spacing="18">
                            
                            <!-- Over het dagboek -->
                            <Border BackgroundColor="#EEF2FF"
                                    Padding="18"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Over uw digitaal dagboek"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    
                                    <Label TextColor="#1F2937" FontSize="13" LineHeight="1.5">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Een opname in het ziekenhuis is een ingrijpende gebeurtenis. Daarom bieden we een digitaal dagboek aan waar u, uw naasten en zorgverleners gedachten, gevoelens, ervaringen en herinneringen kunnen opschrijven.&#x0a;&#x0a;"/>
                                                <Span Text="Schrijven kan helpen om grip te krijgen op wat er gebeurt. Later kunt u samen teruglezen om het proces beter te begrijpen en te verwerken."/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Wat kun je ermee -->
                            <Border BackgroundColor="#C1E8E1"
                                    Padding="16"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="✓ Waarvoor kun je dit dagboek gebruiken?"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    <Label Text="• Ervaringen delen met zorgverleners"
                                           FontSize="13"
                                           TextColor="#1F2937" />
                                    <Label Text="• Notities maken over dagelijkse ontwikkelingen"
                                           FontSize="13"
                                           TextColor="#1F2937" />
                                    <Label Text="• Herinneringen bewaren"
                                           FontSize="13"
                                           TextColor="#1F2937" />
                                    <Label Text="• Foto's, tekeningen en artikelen opslaan"
                                           FontSize="13"
                                           TextColor="#1F2937" />
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#FEF3C7"
                                    Padding="16"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label TextColor="#92400E" FontSize="13" LineHeight="1.5">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="⚠️ Let op: " FontAttributes="Bold"/>
                                            <Span Text="Dit dagboek is niet bedoeld voor medische informatie. Voor medische vragen kunt u altijd terecht bij de verpleegkundige of arts."/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Border>

                            <!-- Divider -->
                            <BoxView HeightRequest="1" 
                                     BackgroundColor="#E5E7EB" 
                                     Margin="0,8,0,8" />

                            <!-- ICCU Informatie -->
                            <Label Text="Intensive Cardiac Care Unit"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937" />

                            <Label TextColor="#1F2937" FontSize="13" LineHeight="1.5">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Uw familielid is opgenomen op de Intensive Cardiac Care Unit, de hartbewaking.&#x0a;&#x0a;"/>
                                        <Span Text="Het bezoek op de afdeling intensieve zorgen is beperkt. Onze patiënten hebben immers rust nodig om hun herstel te bevorderen."/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Bezoekuren -->
                            <Border BackgroundColor="#C1E8E1"
                                    Padding="16"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="🕐 Bezoekuren"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    <Label Text="• van 14u30 tot 15u15"
                                           FontSize="14"
                                           TextColor="#1F2937" />
                                    <Label Text="• van 19u00 tot 19u45"
                                           FontSize="14"
                                           TextColor="#1F2937" />
                                    <Label Text="• Beperkt tot 3 familieleden per bezoekmoment"
                                           FontSize="13"
                                           TextColor="#4B5563"
                                           Margin="0,8,0,0" />
                                    <Label Text="• Enkel toegestaan voor naaste familie"
                                           FontSize="13"
                                           TextColor="#4B5563" />
                                </VerticalStackLayout>
                            </Border>

                            <Label TextColor="#6B7280" FontSize="12" LineHeight="1.5" FontAttributes="Italic">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Afwijkingen van deze bezoekregeling kunnen besproken worden met de verpleegkundige die voor uw familie zorgt."/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <!-- Contact -->
                            <Border BackgroundColor="#F3F4F6"
                                    Padding="16"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="📞 Contact &amp; Informatie"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    
                                    <Label TextColor="#1F2937" FontSize="13" LineHeight="1.4">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• Telefonisch: "/>
                                                <Span Text="011/33 97 30" FontAttributes="Bold"/>
                                                <Span Text=" (best vanaf 10u30)"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    
                                    <Label TextColor="#1F2937" FontSize="13" LineHeight="1.4">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• Ombudsdienst: "/>
                                                <Span Text="011/33 54 90" FontAttributes="Bold"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Label TextColor="#1F2937" FontSize="13" LineHeight="1.4">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="• Sociale dienst: "/>
                                                <Span Text="011/33 54 00" FontAttributes="Bold"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Praktische tips -->
                            <Label Text="💡 Praktische tips"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1F2937"
                                   Margin="0,4,0,0" />

                            <Border BackgroundColor="#D1FAE5"
                                    Padding="16"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="✓ Wat kunt u meebrengen"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#065F46" />
                                    <Label Text="• Thuismedicatie (op vraag van verpleegkundige)"
                                           FontSize="13"
                                           TextColor="#065F46" />
                                    <Label Text="• Toiletgerief (tandenborstel, zeep, scheergerief, pantoffels...)"
                                           FontSize="13"
                                           TextColor="#065F46" />
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="#FEE2E2"
                                    Padding="16"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="✗ Wat brengt u niet mee"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#991B1B" />
                                    <Label Text="• Bloemen noch planten (voedingsbodem voor bacteriën)"
                                           FontSize="13"
                                           TextColor="#991B1B" />
                                    <Label Text="• Snoep of zoetigheden (streng dieet)"
                                           FontSize="13"
                                           TextColor="#991B1B" />
                                    <Label Text="• Waardevolle voorwerpen (zoals juwelen)"
                                           FontSize="13"
                                           TextColor="#991B1B" />
                                </VerticalStackLayout>
                            </Border>

                            <Label TextColor="#6B7280" FontSize="12" LineHeight="1.5" Margin="0,4,0,0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Spreek af wie telefonisch informatie vraagt (contactpersoon of vertrouwenspersoon) en deel deze informatie met elkaar.&#x0a;&#x0a;"/>
                                        <Span Text="Een afspraak met de behandelende arts kan via de verpleegkundige.&#x0a;&#x0a;"/>
                                        <Span Text="Vraag indien nodig een QR-code voor de parking aan de verpleegkundige."/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label Text="We wensen u veel kracht en warmte in deze periode."
                                   FontSize="14"
                                   TextColor="#7BC1B5"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,12,0,0"/>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Footer -->
                    <Border Grid.Row="2"
                            BackgroundColor="#F9FAFB"
                            Padding="24,18"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="0,0,24,24" />
                        </Border.StrokeShape>
                        
                        <Button Text="Sluiten"
                                Command="{Binding CloseInfoCommand}"
                                BackgroundColor="#9ED5CB"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="12"
                                HeightRequest="48"
                                HorizontalOptions="Fill" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>