<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
             xmlns:models="clr-namespace:zorgApp.Models"
             x:Class="zorgApp.Views.DiaryPage"
             x:DataType="viewmodels:DiaryPageViewModel"
             Title="Dagboek">

    <Grid RowDefinitions="*,Auto">
        <!-- Diary Items List -->
        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDiaryItemsCommand}">
            <CollectionView ItemsSource="{Binding DiaryItems}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <StackLayout Padding="20"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                        <Label Text="📝"
                               FontSize="60"
                               HorizontalTextAlignment="Center"
                               Margin="0,0,0,20" />
                        <Label Text="Nog geen dagboek items"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#2C3E50"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Druk op de + knop om een item toe te voegen"
                               FontSize="14"
                               TextColor="Gray"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiaryItem">
                        <Border Margin="15,10"
                                Padding="16"
                                BackgroundColor="White"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black"
                                        Offset="0,2"
                                        Radius="8"
                                        Opacity="0.2" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:DiaryPageViewModel}}, Path=ItemTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout Spacing="8">
                                
                                <!-- TITEL -->
                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#2C3E50"
                                       LineBreakMode="WordWrap" />

                                <!-- DATUM + TIJD -->
                                <Label FontSize="14"
                                       TextColor="#7F8C8D">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="📅 " />
                                            <Span Text="{Binding Timestamp, StringFormat='{0:dd/MM/yyyy HH:mm}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- MAKER (CreatedBy) -->
                                <Label FontSize="14"
                                       TextColor="#7F8C8D">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="👤 " />
                                            <Span Text="{Binding CreatedBy}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Scheidingslijn -->
                                <BoxView HeightRequest="1"
                                         Color="#ECF0F1"
                                         Margin="0,4,0,4" />

                                <!-- BESCHRIJVING -->
                                <Label Text="{Binding Description}"
                                       FontSize="15"
                                       TextColor="#34495E"
                                       MaxLines="3"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Add Button -->
        <Button Grid.Row="1"
                Text="+"
                FontSize="36"
                WidthRequest="70"
                HeightRequest="70"
                CornerRadius="35"
                BackgroundColor="#3498DB"
                TextColor="White"
                Margin="0,0,20,20"
                HorizontalOptions="End"
                VerticalOptions="End"
                Command="{Binding AddItemCommand}">
            <Button.Shadow>
                <Shadow Brush="Black"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.3" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
