<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
    x:Class="zorgApp.Views.PatientLoginPage"
    x:DataType="viewmodels:PatientLoginViewModel"
    Title="Patiënt Login"
    BackgroundColor="#F5F7FA">

    <VerticalStackLayout
        Padding="40"
        Spacing="30"
        VerticalOptions="Center">

        <Border
            Padding="40"
            BackgroundColor="White"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.1" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="25">
                <Label 
                    Text="🏥" 
                    FontSize="80" 
                    HorizontalTextAlignment="Center" />
                
                <Label 
                    Text="Welkom Patiënt" 
                    FontSize="28" 
                    FontAttributes="Bold" 
                    TextColor="#1F2937" 
                    HorizontalTextAlignment="Center" />
                
                <Label 
                    Text="Voer uw unieke code in om uw dagboek te bekijken" 
                    FontSize="14" 
                    TextColor="#6B7280" 
                    HorizontalTextAlignment="Center" />

                <Entry 
                    Text="{Binding UniqueCode}"
                    Placeholder="Bijv. ABC123"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    MaxLength="6"
                    Keyboard="Default"
                    Margin="0,10,0,0" />

                <Button 
                    Text="Inloggen"
                    Command="{Binding LoginCommand}"
                    HeightRequest="55"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="16"
                    Margin="0,10,0,0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0.0" />
                            <GradientStop Color="#8B5CF6" Offset="1.0" />
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>

                <ActivityIndicator 
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    Color="#6366F1"
                    Margin="0,10,0,0" />
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>