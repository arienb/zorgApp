<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
    x:Class="zorgApp.Views.NurseLoginPage"
    x:DataType="viewmodels:NurseLoginViewModel"
    Title="Verpleegkundige Login"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="40"
            Spacing="30"
            VerticalOptions="Center">

            <Border
                Padding="40"
                BackgroundColor="White"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="20" Opacity="0.1" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="25">

                    <Label 
                        Text="Verpleegkundige Login" 
                        FontSize="24" 
                        FontAttributes="Bold" 
                        TextColor="#1F2937" 
                        HorizontalTextAlignment="Center" />

                    <!-- Department Name -->
                    <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                        <Label 
                            Text="Afdeling" 
                            FontSize="14" 
                            TextColor="#374151" 
                            FontAttributes="Bold" />
                        <Entry 
                            Text="{Binding DepartmentName}"
                            Placeholder="Bijv. ICCU, Cardiologie..."
                            FontSize="16"
                            Keyboard="Text" />
                    </VerticalStackLayout>

                    <!-- Password with visibility toggle -->
                    <VerticalStackLayout Spacing="8">
                        <Label 
                            Text="Wachtwoord" 
                            FontSize="14" 
                            TextColor="#374151" 
                            FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry 
                                Grid.Column="0"
                                Text="{Binding Password}"
                                Placeholder="Minimaal 4 tekens"
                                FontSize="16"
                                IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                Keyboard="Default" />
                            <Button 
                                Grid.Column="1"
                                Text="?"
                                WidthRequest="50"
                                HeightRequest="40"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="#6366F1"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                VerticalOptions="Center"
                                Padding="0"
                                Margin="4,0,0,0"/>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Login Button -->
                    <Button 
                        Text="Inloggen"
                        Command="{Binding LoginCommand}"
                        HeightRequest="55"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="16"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                        Margin="0,10,0,0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0.0" />
                                <GradientStop Color="#8B5CF6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <ActivityIndicator 
                        IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        Color="#6366F1" />

                    <!-- Divider -->
                    <BoxView 
                        HeightRequest="1" 
                        BackgroundColor="#E5E7EB" 
                        Margin="0,10,0,5" />

                    <!-- Create Department Link (smaller and less prominent) -->
                    <Label 
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,10">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span 
                                    Text="Nieuwe afdeling "
                                    FontSize="12"
                                    TextColor="#9CA3AF" />
                                <Span 
                                    Text="aanmaken"
                                    FontSize="12"
                                    TextColor="#6366F1"
                                    TextDecorations="Underline" />
                            </FormattedString>
                        </Label.FormattedText>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CreateDepartmentCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <ActivityIndicator 
                        IsRunning="{Binding IsCreatingDepartment}"
                        IsVisible="{Binding IsCreatingDepartment}"
                        Color="#6366F1" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>