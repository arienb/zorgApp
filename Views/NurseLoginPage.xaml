<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
    x:Class="zorgApp.Views.NurseLoginPage"
    x:DataType="viewmodels:NurseLoginViewModel"
    Title="Verpleegkundige Login"
    BackgroundColor="#F5F7FA"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto,*" Padding="50,70,50,50">
        
        <!-- Logo bovenaan -->
        <Image 
            Grid.Row="0"
            Source="logo_jessa.png"
            HeightRequest="80"
            WidthRequest="120"
            Aspect="AspectFit"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Margin="0,0,0,35" />

        <!-- Login Card -->
        <Border
            Grid.Row="1"
            Padding="40,35"
            BackgroundColor="White"
            StrokeThickness="0"
            HorizontalOptions="Center"
            WidthRequest="350">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="24" Opacity="0.08" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="25">

                <!-- Afdeling -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                        Text="Afdeling" 
                        FontSize="14" 
                        TextColor="#6B7280" 
                        FontAttributes="Bold" />
                    <Border
                        StrokeThickness="2"
                        Stroke="#E5E7EB"
                        BackgroundColor="White"
                        Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        
                        <Entry 
                            Text="{Binding DepartmentName}"
                            FontSize="16"
                            TextColor="#1F2937"
                            Keyboard="Text"
                            Margin="15,12"
                            BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <!-- Wachtwoord -->
                <VerticalStackLayout Spacing="8">
                    <Label 
                        Text="Wachtwoord" 
                        FontSize="14" 
                        TextColor="#6B7280" 
                        FontAttributes="Bold" />
                    <Border
                        StrokeThickness="2"
                        Stroke="#E5E7EB"
                        BackgroundColor="White"
                        Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry 
                                Grid.Column="0"
                                Text="{Binding Password}"
                                FontSize="16"
                                TextColor="#1F2937"
                                IsPassword="{Binding IsPasswordVisible, Converter={StaticResource InvertedBoolConverter}}"
                                Keyboard="Default"
                                Margin="15,12,0,12"
                                BackgroundColor="Transparent" />
                            <Button 
                                Grid.Column="1"
                                Text="👁"
                                WidthRequest="50"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="#6B7280"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                VerticalOptions="Center"
                                Padding="0"
                                Margin="0,0,8,0"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Login Button -->
                <Button 
                    Text="Inloggen"
                    Command="{Binding LoginCommand}"
                    HeightRequest="55"
                    FontSize="17"
                    FontAttributes="Bold"
                    BackgroundColor="#9ED5CB"
                    TextColor="White"
                    CornerRadius="12"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"
                    Margin="0,15,0,0" />

                <ActivityIndicator 
                    IsRunning="{Binding IsLoading}"
                    IsVisible="{Binding IsLoading}"
                    Color="#9ED5CB"
                    Margin="0,5,0,0" />

                <!-- Divider -->
                <BoxView 
                    HeightRequest="1" 
                    BackgroundColor="#E5E7EB" 
                    Margin="0,10,0,10" />

                <!-- Nieuwe afdeling aanmaken -->
                <Label 
                    HorizontalTextAlignment="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span 
                                Text="Nieuwe afdeling "
                                FontSize="13"
                                TextColor="#9CA3AF" />
                            <Span 
                                Text="aanmaken"
                                FontSize="13"
                                TextColor="#9ED5CB"
                                FontAttributes="Bold" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CreateDepartmentCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <ActivityIndicator 
                    IsRunning="{Binding IsCreatingDepartment}"
                    IsVisible="{Binding IsCreatingDepartment}"
                    Color="#9ED5CB" />
            </VerticalStackLayout>
        </Border>

        <!-- Back button onderaan -->
        <Button 
            Grid.Row="2"
            Text="Terug"
            Command="{Binding BackCommand}"
            BackgroundColor="Transparent"
            TextColor="#6B7280"
            FontSize="15"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Margin="0,30,0,0" />
    </Grid>
</ContentPage>