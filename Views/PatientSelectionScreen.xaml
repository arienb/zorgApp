<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewmodels="clr-namespace:zorgApp.ViewModels"
    xmlns:models="clr-namespace:zorgApp.Models"
    x:Class="zorgApp.Views.PatientSelectionScreen"
    x:DataType="viewmodels:PatientSelectionScreenViewModel"
    Title="Patiënten"
    BackgroundColor="#F5F7FA"
    Shell.NavBarIsVisible="True">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="*,Auto,Auto">

        <RefreshView
            Grid.Row="0"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding LoadPatientsCommand}"
            RefreshColor="#6366F1">

            <CollectionView
                ItemsSource="{Binding Patients}"
                SelectionMode="None"
                Margin="0,10,0,0">

                <CollectionView.EmptyView>
                    <StackLayout
                        Padding="40"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                        <Border
                            Padding="40,50"
                            BackgroundColor="White"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="15">
                                <Label Text="Nog geen patiënten beschikbaar" FontSize="20" FontAttributes="Bold" TextColor="#1F2937" HorizontalTextAlignment="Center" />
                                <Label Text="Gebruik de + knop om een patiënt toe te voegen" FontSize="14" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Patient">
                        <Border
                            Margin="16,8"
                            Padding="16"
                            BackgroundColor="White"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#6366F1" Offset="0,4" Radius="12" Opacity="0.15" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PatientSelectionScreenViewModel}}, Path=SelectPatientCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="5">

                                <!-- Profile Picture -->
                                <Border Grid.Row="0" 
                                        Grid.RowSpan="3"
                                        Grid.Column="0"
                                        StrokeThickness="2" 
                                        Stroke="#6366F1"
                                        WidthRequest="56" 
                                        HeightRequest="56"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="28"/>
                                    </Border.StrokeShape>
                                    <Image Source="{Binding ProfileImageUrl, TargetNullValue='profile.png', FallbackValue='profile.png'}" 
                                           Aspect="AspectFill"
                                           WidthRequest="52" 
                                           HeightRequest="52"/>
                                </Border>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#1F2937" 
                                    VerticalOptions="End"/>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Email}"
                                    FontSize="14"
                                    TextColor="#6B7280" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{Binding UniqueCode, StringFormat='Code: {0}'}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#6366F1" />

                                <!-- Edit Button -->
                                <Border
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="2"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    BackgroundColor="#EEF2FF">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PatientSelectionScreenViewModel}}, Path=EditPatientCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Label
                                        Text="✏️"
                                        FontSize="16"
                                        TextColor="#6366F1"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>

                                <!-- Delete Button -->
                                <Border
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="3"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    BackgroundColor="#F3F4F6">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PatientSelectionScreenViewModel}}, Path=RemovePatientCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <Label
                                        Text="🗑️"
                                        FontSize="16"
                                        TextColor="#6B7280"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

        <!-- Add Patient Button -->
        <Border
            Grid.Row="1"
            WidthRequest="70"
            HeightRequest="70"
            Margin="0,0,20,20"
            StrokeThickness="0"
            HorizontalOptions="End"
            VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="35" />
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0.0" />
                    <GradientStop Color="#8B5CF6" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="#6366F1" Offset="0,6" Radius="20" Opacity="0.4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddPatientCommand}" />
            </Border.GestureRecognizers>

            <Label
                Text="+"
                FontSize="40"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
        </Border>

        <!-- Logout Button -->
        <Button 
            Grid.Row="2"
            Text="Uitloggen"
            Command="{Binding LogoutCommand}"
            BackgroundColor="#E5E7EB"
            TextColor="#6B7280"
            FontSize="13"
            CornerRadius="8"
            Margin="20,0,20,15"
            HeightRequest="36"
            HorizontalOptions="Center"
            WidthRequest="120" />
    </Grid>
</ContentPage>