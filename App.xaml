<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:zorgApp"
             xmlns:converters="clr-namespace:zorgApp.Converters"
             x:Class="zorgApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:EditModeTitleConverter x:Key="EditModeTitleConverter" />
            <converters:EditModeHeaderConverter x:Key="EditModeHeaderConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
